{
  "name": "gymeye",
  "version": "1.0.0",
  "description": "GYMeye - AI-Powered Fitness Trainer",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "all": "concurrently \"npm run server\" \"npm run client\" \"npm run rag\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "rag": "cd ../gym-rag-main && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
